# ═══════════════════════════════════════════════════════════
# Sistema Padaria O Pão — variáveis de ambiente
#
# Copie este arquivo: cp .env.example .env
# Edite o .env com os valores reais e NUNCA commite o .env.
# ═══════════════════════════════════════════════════════════

# ── Postgres (banco interno) ──
POSTGRES_DB=padaria
POSTGRES_USER=padaria
# Gere uma senha forte: openssl rand -base64 32
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# ── Segredos do Flask ──
# Gere: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_GERANDO_NOVO_TOKEN
# Senha do admin inicial (você pode trocar pelo painel depois)
ADMIN_PASSWORD=admin

# ── URL pública do sistema ──
APP_BASE_URL=https://gestao.opaopadariaartesanal.com.br

# ── Cloudflare Tunnel ──
# Crie em: https://one.dash.cloudflare.com/ → Networks → Tunnels → Create
# Cole aqui o token gerado (começa com "eyJ...")
CLOUDFLARE_TUNNEL_TOKEN=

# ── Copilot Claude ──
ANTHROPIC_API_KEY=

# ── Seru (PDV) ──
SERU_CLIENT_ID=
SERU_CLIENT_SECRET=
SERU_AUTO_SYNC=1

# ── VNDA (e-commerce) ──
VNDA_API_TOKEN=
VNDA_SHOP_HOST=www.padariaartesanalonline.com.br

# ── Slack bot ──
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CANAIS_PERMITIDOS=
SLACK_CANAL_RESUMO_DIARIO=
SLACK_CANAL_PEDIDOS=

# ── Z-API (WhatsApp) ──
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_NUMERO_DESTINO=
ZAPI_NUMEROS_PERMITIDOS=

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=
ROTA_ORIGEM_LAT=
ROTA_ORIGEM_LNG=
ROTA_ORIGEM_ENDERECO=

# ── Dropbox ──
DROPBOX_ACCESS_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_PASTA_BASE=/Apps/Receitas-Entregas

# ── Bot API (WhatsApp n8n) ──
BOT_API_TOKEN=
BOT_ALLOWED_PHONES=

# ── Sentry (monitoramento de erros — opcional) ──
SENTRY_DSN=
